[Unit]
Description=Fan Control Daemon

[Service]
Type=simple
User=root
# The runtime dir is group-writable for wheel so the CLI and the Omarchy bar
# widget can write override.json without sudo. The daemon validates it.
Group=wheel
ExecStart=/usr/local/bin/g5ge-fandaemon.py
Restart=always
RestartSec=5
RuntimeDirectory=g5ge-fan
RuntimeDirectoryMode=0775
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
